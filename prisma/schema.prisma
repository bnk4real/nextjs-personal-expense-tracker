generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Image {
  id       String @id
  reportId String
  filename String
  mimeType String
  size     Int
  Report   Report @relation(fields: [reportId], references: [id])
}

model Report {
  id        String   @id
  title     String
  prompt    String?
  findings  Json
  createdAt DateTime @default(now())
  Image     Image[]
}

model ai_models {
  id          String   @id
  name        String   @unique
  description String?
  created_at  DateTime @default(now())
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model people {
  first_name            String?                 @default("")
  last_name             String?
  username              String?                 @unique
  password_hash         String?
  created_at            DateTime                @default(now())
  user_id               String                  @id @db.Uuid
  email                 String?                 @unique
  avatar                String?
  sessions              sessions[]
  subscriptions         subscriptions[]
  categories            Category[]
  chatSessions          ChatSession[]
  monthlyBudgets        MonthlyBudget[]
  aiSettings            AiProviderSetting[]
  transactionProvenance TransactionProvenance[]
  plaidItems            PlaidItem[]
}

model sessions {
  id         String   @id @db.Uuid
  user_id    String   @db.Uuid
  token_hash String   @unique
  expires_at DateTime
  created_at DateTime @default(now())
  people     people   @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([user_id])
}

model subscriptions {
  id                String                @id @default(uuid()) @db.Uuid
  user_id           String                @db.Uuid
  name              String
  provider          String?
  price_cents       Int
  currency          String                @default("USD")
  billing_cycle     String                @default("monthly")
  start_date        DateTime              @default(now())
  next_payment_date DateTime?
  status            String                @default("active")
  end_date          DateTime?
  website_url       String?
  notes             String?
  created_at        DateTime              @default(now())
  updated_at        DateTime              @updatedAt
  people            people                @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  categoryId        Int?
  category          Category?             @relation(fields: [categoryId], references: [id])
  payments          SubscriptionPayment[]

  @@index([next_payment_date])
  @@index([user_id])
  @@index([status])
}

model SubscriptionPayment {
  id             String    @id @default(uuid()) @db.Uuid
  subscriptionId String    @db.Uuid
  amount         Int // price in cents
  currency       String    @default("USD")
  paymentDate    DateTime? // actual payment date
  dueDate        DateTime // scheduled due date
  status         String    @default("pending") // 'paid', 'pending', 'overdue', 'cancelled'
  paymentMethod  String? // optional payment method
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  subscription subscriptions @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([paymentDate])
  @@index([dueDate])
  @@index([status])
  @@index([subscriptionId, status])
}

model Expense {
  id          Int                    @id @default(autoincrement())
  amount      Float
  category    String
  date        String
  description String
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  accountId   Int?
  account     Account?               @relation(fields: [accountId], references: [id])
  provenance  TransactionProvenance?
}

model Category {
  id            Int             @id @default(autoincrement())
  name          String
  user_id       String?         @db.Uuid
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  user          people?         @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  subscriptions subscriptions[]

  @@unique([name, user_id])
}

model Account {
  id            Int            @id @default(autoincrement())
  name          String
  type          String
  balance       Float          @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  creditLimit   Float?
  expenses      Expense[]
  incomes       Income[]
  transfersOut  Transfer[]     @relation("TransferFromAccount")
  transfersIn   Transfer[]     @relation("TransferToAccount")
  plaidAccounts PlaidAccount[]
}

model Income {
  id           Int                    @id @default(autoincrement())
  amount       Float
  source       String
  date         String
  description  String
  notes        String?
  accountId    Int?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  filingStatus String?
  state        String?
  account      Account?               @relation(fields: [accountId], references: [id])
  provenance   TransactionProvenance?
}

model Transfer {
  id             Int                    @id @default(autoincrement())
  amount         Float
  date           String
  description    String
  fromAccountId  Int?
  toAccountId    Int?
  affectsBalance Boolean                @default(false)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  fromAccount    Account?               @relation("TransferFromAccount", fields: [fromAccountId], references: [id])
  toAccount      Account?               @relation("TransferToAccount", fields: [toAccountId], references: [id])
  provenance     TransactionProvenance?

  @@index([date])
  @@index([fromAccountId])
  @@index([toAccountId])
}

model TransactionProvenance {
  id                  String            @id @default(uuid()) @db.Uuid
  userId              String            @db.Uuid
  sourceType          String
  source              String
  externalId          String?
  importHash          String?
  currency            String            @default("USD")
  originalDescription String
  rawPayload          Json?
  importedAt          DateTime          @default(now())
  lastSyncedAt        DateTime?
  expenseId           Int?              @unique
  incomeId            Int?              @unique
  transferId          Int?              @unique
  user                people            @relation(fields: [userId], references: [user_id], onDelete: Cascade)
  expense             Expense?          @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  income              Income?           @relation(fields: [incomeId], references: [id], onDelete: Cascade)
  transfer            Transfer?         @relation(fields: [transferId], references: [id], onDelete: Cascade)
  plaidTransaction    PlaidTransaction?

  @@unique([userId, importHash])
  @@unique([userId, source, externalId])
  @@index([userId, importedAt])
  @@index([sourceType, source])
}

model PlaidItem {
  id                   String         @id @default(uuid()) @db.Uuid
  userId               String         @db.Uuid
  itemId               String         @unique
  encryptedAccessToken String
  institutionId        String?
  institutionName      String?
  cursor               String?
  status               String         @default("syncing")
  errorCode            String?
  errorMessage         String?
  autoImportStartDate  String
  lastSyncedAt         DateTime?
  lastWebhookAt        DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  user                 people         @relation(fields: [userId], references: [user_id], onDelete: Cascade)
  accounts             PlaidAccount[]

  @@index([userId])
  @@index([status])
}

model PlaidAccount {
  id               String             @id @default(uuid()) @db.Uuid
  plaidItemId      String             @db.Uuid
  accountId        String             @unique
  localAccountId   Int?
  name             String
  officialName     String?
  mask             String?
  type             String
  subtype          String?
  currentBalance   Float?
  availableBalance Float?
  creditLimit      Float?
  currency         String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  item             PlaidItem          @relation(fields: [plaidItemId], references: [id], onDelete: Cascade)
  localAccount     Account?           @relation(fields: [localAccountId], references: [id], onDelete: SetNull)
  transactions     PlaidTransaction[]

  @@index([plaidItemId])
  @@index([localAccountId])
}

model PlaidTransaction {
  id                   String                 @id @default(uuid()) @db.Uuid
  plaidAccountId       String                 @db.Uuid
  transactionId        String                 @unique
  pendingTransactionId String?
  provenanceId         String?                @unique @db.Uuid
  date                 String
  authorizedDate       String?
  amountCents          Int
  currency             String
  name                 String
  merchantName         String?
  categoryPrimary      String?
  categoryDetailed     String?
  pending              Boolean                @default(false)
  status               String                 @default("staged")
  rawPayload           Json
  removedAt            DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  plaidAccount         PlaidAccount           @relation(fields: [plaidAccountId], references: [id], onDelete: Cascade)
  provenance           TransactionProvenance? @relation(fields: [provenanceId], references: [id], onDelete: SetNull)

  @@index([plaidAccountId, date])
  @@index([pendingTransactionId])
  @@index([status])
}

model Debt {
  id             Int      @id @default(autoincrement())
  type           String
  lender         String
  accountNumber  String?
  totalAmount    Float
  currentBalance Float
  interestRate   Float?
  minimumPayment Float?
  dueDate        String?
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ChatSession {
  id        String        @id @default(uuid()) @db.Uuid
  user_id   String        @db.Uuid
  title     String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      people        @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  messages  ChatMessage[]

  @@index([user_id])
  @@index([updatedAt])
}

model ChatMessage {
  id        String      @id @default(uuid()) @db.Uuid
  sessionId String      @db.Uuid
  role      String
  content   String
  createdAt DateTime    @default(now())
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([createdAt])
}

model MonthlyBudget {
  id               Int                   @id @default(autoincrement())
  userId           String                @db.Uuid
  month            String
  amountCents      Int
  warningThreshold Int                   @default(90)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  user             people                @relation(fields: [userId], references: [user_id], onDelete: Cascade)
  categoryLimits   BudgetCategoryLimit[]

  @@unique([userId, month])
  @@index([userId])
  @@index([month])
}

model BudgetCategoryLimit {
  id          Int           @id @default(autoincrement())
  budgetId    Int
  category    String
  amountCents Int
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  budget      MonthlyBudget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@unique([budgetId, category])
  @@index([budgetId])
}

model AiProviderSetting {
  id              Int       @id @default(autoincrement())
  userId          String    @db.Uuid
  provider        String
  encryptedApiKey String
  keyHint         String
  model           String
  isEnabled       Boolean   @default(true)
  lastValidatedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            people    @relation(fields: [userId], references: [user_id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
}
